# Gnani and Gemini API keys
GNANI_API_KEY=உன்னுடைய_உண்மையான_Gnani_API_Key
GEMINI_API_KEY=உன்னுடைய_உண்மையான_Gemini_API_Key

# Gemini settings
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.6-flash

# Gnani Speech-to-Text
GNANI_STT_URL=https://api.vachana.ai/stt/v3
GNANI_STT_MODEL=prisma-v3.0

# Gnani Text-to-Speech
GNANI_TTS_URL=https://api.vachana.ai/api/v1/tts/inference
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_VOICE=Shivani
GNANI_TTS_LANGUAGE=en-IN
GNANI_TTS_SPEED=1.0

# Audio settings
MAX_AUDIO_SECONDS=120
GNANI_CHUNK_SECONDS=28

# Supabase
SUPABASE_URL=https://dnbezccyfsgjcqrimdks.supabase.co
SUPABASE_PUBLISHABLE_KEY=உன்னுடைய_Supabase_Publishable_Key
SUPABASE_SECRET_KEY=உன்னுடைய_Supabase_Secret_Key

REQUIRE_AUTH=true

# Local development
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173