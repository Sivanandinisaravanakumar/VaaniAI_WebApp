# Keep real API keys in backend/.env only. Never place secrets in the React frontend.
GNANI_API_KEY=your_gnani_api_key
GEMINI_API_KEY=your_gemini_api_key

# Use model IDs enabled for your Google AI Studio project.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.7-flash

GNANI_STT_URL=https://api.vachana.ai/stt/v3
GNANI_STT_MODEL=prisma-v3.0
GNANI_TTS_URL=https://api.vachana.ai/api/v1/tts/inference
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_VOICE=Shivani
GNANI_TTS_LANGUAGE=en-IN
GNANI_TTS_SPEED=1.0

MAX_AUDIO_SECONDS=120
GNANI_CHUNK_SECONDS=28
DATABASE_PATH=./vaaniai.db
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
